datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id String @id @default(uuid())

  walletAddress String @unique

  createdAt DateTime @default(now())
}


model WalletNonce {

  id String @id @default(uuid())

  walletAddress String

  nonce String

  expiresAt DateTime

  used Boolean @default(false)

}